{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaoqia.com/evidence/evidence-ref.schema.json",
  "x-version": "1.0.0",
  "title": "EvidenceRef 证据引用",
  "description": "可被引用的证据片段：指向某个快照在某个处理管线版本下的规范化文档中的一个位置。由 evidence 分配 ev_ 标识；字段溯源（provenance.evidence_ref）与研究报告引用都指向它。",
  "type": "object",
  "required": [
    "id",
    "snapshot_ref",
    "pipeline_version",
    "locator",
    "quote_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "snapshot_ref": {
      "type": "string",
      "pattern": "^snp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "pipeline_version": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "locator": {
      "$ref": "normalized-document.schema.json#/$defs/locator"
    },
    "quote_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "被引用原文片段的哈希，用于校验定位未漂移"
    }
  }
}
