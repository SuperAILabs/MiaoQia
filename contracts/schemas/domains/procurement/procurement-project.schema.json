{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaoqia.com/domains/procurement/procurement-project.schema.json",
  "x-version": "1.2.0",
  "title": "ProcurementProject 采购项目",
  "description": "采购项目的独立不可变聚合版本。字段prov指向所选公告版本证据，成员固定版本保存在聚合依赖中。当前实现支持有依据的招标/中标归并，其他生命周期不自动应用。",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../common/types.schema.json#/$defs/public_fact_meta"
    }
  ],
  "required": [
    "id",
    "info_domain",
    "stage",
    "title",
    "buyer",
    "notice_ids",
    "lots"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "info_domain": {
      "const": "INF-PROC"
    },
    "stage": {
      "enum": [
        "intent",
        "announced",
        "amended",
        "evaluating",
        "candidate_published",
        "awarded",
        "failed",
        "terminated",
        "contracted",
        "accepted",
        "shortlisted",
        "acceptance_failed",
        "partially_accepted",
        "acceptance_pending"
      ]
    },
    "trading_system": {
      "$ref": "defs.schema.json#/$defs/trading_system"
    },
    "method": {
      "$ref": "defs.schema.json#/$defs/method"
    },
    "procurement_category": {
      "$ref": "defs.schema.json#/$defs/procurement_category"
    },
    "title": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "project_code": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "approval_code": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "investment_project_id": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "所属投资项目（entity-graph 的 Project 实体）的便捷字段：仅在整个采购项目归属唯一、已确认的投资项目时出现。归属以 entity-graph 的 part_of 归属边为准（可按标包、可归属多个项目、可修订撤销），时间线与项目链按归属边查询，不以本字段为不变量"
    },
    "buyer": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref"
    },
    "agency": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref"
    },
    "project_owner": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref",
      "description": "建设单位或项目业主"
    },
    "location": {
      "$ref": "../../common/types.schema.json#/$defs/region",
      "description": "项目实施地（建设、服务或采购标的使用地）所在行政区划；采购人所在地取采购人登记信息，交付地见 conditions.delivery_region。地点角色不同的统计不混用"
    },
    "budget": {
      "$ref": "../../common/types.schema.json#/$defs/money"
    },
    "notice_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ntc_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "description": "有发布时间时按发布时间排序，否则按稳定公告标识排序。"
    },
    "first_published_at": {
      "$ref": "../../common/types.schema.json#/$defs/instant"
    },
    "lots": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/project_lot"
      },
      "description": "已确认标包；空数组表示尚无已确认标包，不能把公告默认容器1推断成跨公告标包。"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "project_lot": {
      "type": "object",
      "required": [
        "id",
        "lot_key"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^lot_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "lot_key": {
          "type": "string"
        },
        "name": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "procurement_category": {
          "$ref": "defs.schema.json#/$defs/procurement_category"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/item"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/requirement"
          }
        },
        "deadlines": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/deadline"
          },
          "description": "应用全部更正后的当前时间节点"
        },
        "budget": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "max_price": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "consortium_allowed": {
          "type": "boolean"
        },
        "authorization_required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "evaluating",
            "candidate_published",
            "awarded",
            "failed",
            "terminated",
            "contracted",
            "accepted",
            "shortlisted",
            "acceptance_failed",
            "partially_accepted",
            "acceptance_pending"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/bid_result"
          }
        },
        "winners": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/bid_result"
          },
          "description": "实际中标/成交供应商，可多家；框架第一阶段入围另存shortlisted_suppliers"
        },
        "award_amount": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "contract_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ctr_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "conditions": {
          "$ref": "defs.schema.json#/$defs/procurement_conditions"
        },
        "max_price_rate": {
          "$ref": "../../common/types.schema.json#/$defs/rate"
        },
        "project_name": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "合并采购中该标包所属建设项目，不能用公告级项目名覆盖所有标包"
        },
        "project_code": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "project_owner": {
          "$ref": "../../common/types.schema.json#/$defs/org_ref"
        },
        "estimated_contract_amount": {
          "$ref": "../../common/types.schema.json#/$defs/money",
          "description": "合同估算价；不等于采购预算或中标金额"
        },
        "ending": {
          "$ref": "notice.schema.json#/$defs/ending_section"
        },
        "shortlisted_suppliers": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/bid_result"
          }
        }
      }
    }
  }
}
