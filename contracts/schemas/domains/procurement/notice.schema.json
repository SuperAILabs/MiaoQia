{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaoqia.com/domains/procurement/notice.schema.json",
  "x-version": "1.0.0",
  "title": "Notice 公告",
  "description": "一条公告按原文表达的领域事实（随解析修订产生新版本）。跨公告的当前状态见 procurement-project.schema.json。未分包的公告视为一个标包（lot_key = \"1\"）。",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../common/types.schema.json#/$defs/public_fact_meta"
    },
    {
      "if": {
        "properties": {
          "notice_type": {
            "enum": [
              "amendment",
              "clarification"
            ]
          }
        }
      },
      "then": {
        "required": [
          "amendment"
        ]
      },
      "else": {
        "if": {
          "properties": {
            "notice_type": {
              "const": "contract"
            }
          }
        },
        "then": {
          "required": [
            "contract"
          ]
        },
        "else": {
          "if": {
            "properties": {
              "notice_type": {
                "const": "acceptance"
              }
            }
          },
          "then": {
            "required": [
              "acceptance"
            ]
          },
          "else": {
            "if": {
              "properties": {
                "notice_type": {
                  "enum": [
                    "termination",
                    "failure"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "ending"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "notice_type": {
            "enum": [
              "candidate",
              "award"
            ]
          }
        }
      },
      "then": {
        "if": {
          "required": [
            "result_details_pending"
          ],
          "properties": {
            "result_details_pending": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "quality"
          ],
          "properties": {
            "quality": {
              "properties": {
                "status": {
                  "enum": [
                    "warning",
                    "suspect"
                  ]
                },
                "warnings": {
                  "contains": {
                    "properties": {
                      "code": {
                        "const": "RESULT_DETAILS_PENDING"
                      }
                    },
                    "required": [
                      "code"
                    ]
                  }
                }
              },
              "required": [
                "status",
                "warnings"
              ]
            }
          }
        },
        "else": {
          "properties": {
            "lots": {
              "contains": {
                "required": [
                  "bid_results"
                ],
                "properties": {
                  "bid_results": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "id",
    "info_domain",
    "notice_type",
    "title",
    "lots"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ntc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "info_domain": {
      "const": "INF-PROC"
    },
    "notice_type": {
      "$ref": "defs.schema.json#/$defs/notice_type"
    },
    "trading_system": {
      "$ref": "defs.schema.json#/$defs/trading_system"
    },
    "method": {
      "$ref": "defs.schema.json#/$defs/method"
    },
    "procurement_category": {
      "$ref": "defs.schema.json#/$defs/procurement_category"
    },
    "title": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "notice_code": {
      "$ref": "../../common/types.schema.json#/$defs/text",
      "description": "公告编号"
    },
    "project_code": {
      "$ref": "../../common/types.schema.json#/$defs/text",
      "description": "项目编号（跨公告关联的首要依据）"
    },
    "approval_code": {
      "$ref": "../../common/types.schema.json#/$defs/text",
      "description": "投资项目审批或备案编号"
    },
    "project_id": {
      "type": "string",
      "pattern": "^pp_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "当前归并到的采购项目。权威记录是 domain-intelligence 的 AggregationLink，本字段为其当前指针"
    },
    "related_notice_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ntc_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "description": "公告中显式引用的前序公告"
    },
    "buyer": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref",
      "description": "公告正文明确时记录；缺失则省略并进入质量复核，不从项目标题猜测采购人"
    },
    "agency": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref"
    },
    "project_owner": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref",
      "description": "建设单位或项目业主（施工企业作为招标人采购物资时尤其重要）"
    },
    "single_source_supplier": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref",
      "description": "单一来源公示的拟定供应商"
    },
    "location": {
      "$ref": "../../common/types.schema.json#/$defs/region"
    },
    "funding_source": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "budget": {
      "$ref": "../../common/types.schema.json#/$defs/money",
      "description": "公告级预算；各标包预算见 lots[].budget"
    },
    "max_price": {
      "$ref": "../../common/types.schema.json#/$defs/money"
    },
    "lots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lot_section"
      }
    },
    "amendment": {
      "$ref": "#/$defs/amendment_section"
    },
    "contract": {
      "$ref": "#/$defs/contract_section"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance_section"
    },
    "ending": {
      "$ref": "#/$defs/ending_section"
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/contact"
      }
    },
    "award_amount": {
      "$ref": "../../common/types.schema.json#/$defs/money",
      "description": "公告明确的结果汇总金额；不能分摊到未知标包，也不能用代理费替代"
    },
    "result_details_pending": {
      "type": "boolean",
      "description": "结果主体/标包只在当前不可得附件中，已记录quality警告时为true；不伪造中标人"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "lot_section": {
      "type": "object",
      "description": "本公告中出现的一个标包",
      "required": [
        "lot_key"
      ],
      "additionalProperties": false,
      "properties": {
        "lot_key": {
          "type": "string",
          "description": "原文标包号；未分包为 \"1\""
        },
        "lot_id": {
          "type": "string",
          "pattern": "^lot_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "归并到的项目标包"
        },
        "name": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "procurement_category": {
          "$ref": "defs.schema.json#/$defs/procurement_category"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/item"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/requirement"
          }
        },
        "deadlines": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/deadline"
          }
        },
        "budget": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "max_price": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "consortium_allowed": {
          "type": "boolean"
        },
        "authorization_required": {
          "type": "boolean",
          "description": "是否要求原厂授权"
        },
        "bid_bond": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "document_fee": {
          "$ref": "../../common/types.schema.json#/$defs/money",
          "description": "招标文件售价"
        },
        "bond_guarantee_accepted": {
          "type": "boolean",
          "description": "是否接受保函"
        },
        "evaluation_method": {
          "$ref": "defs.schema.json#/$defs/evaluation_method"
        },
        "bid_results": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/bid_result"
          }
        },
        "conditions": {
          "$ref": "defs.schema.json#/$defs/procurement_conditions"
        },
        "max_price_rate": {
          "$ref": "../../common/types.schema.json#/$defs/rate"
        },
        "project_name": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "合并采购中该标包所属建设项目，不能用公告级项目名覆盖所有标包"
        },
        "project_code": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "project_owner": {
          "$ref": "../../common/types.schema.json#/$defs/org_ref"
        },
        "estimated_contract_amount": {
          "$ref": "../../common/types.schema.json#/$defs/money",
          "description": "合同估算价；不等于采购预算或中标金额"
        },
        "ending": {
          "$ref": "#/$defs/ending_section",
          "description": "仅当前标包的流标/废标/终止，不能传播成整个项目失败"
        }
      }
    },
    "amendment_section": {
      "type": "object",
      "required": [
        "amends_notice_ids",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "amends_notice_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ntc_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "description": "已解析的前序公告标识；暂未归并时允许为空，保留 original_reference 并进入复核，不伪造标识"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "field_path",
              "prov"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^amd_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "field_path": {
                "type": "string",
                "description": "被更正公告中的字段 JSON Pointer，如 /lots/0/deadlines/1/at；无法定位时为说明性路径并降为人工复核"
              },
              "before": {},
              "after": {},
              "prov": {
                "$ref": "../../common/types.schema.json#/$defs/provenance"
              }
            }
          }
        },
        "original_reference": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "summary": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "amends_notice_ids": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "required": [
              "original_reference"
            ]
          }
        }
      ]
    },
    "contract_section": {
      "type": "object",
      "required": [
        "id",
        "supplier",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ctr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "lot_id": {
          "type": "string",
          "pattern": "^lot_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "supplier": {
          "$ref": "../../common/types.schema.json#/$defs/org_ref"
        },
        "amount": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "signed_at": {
          "$ref": "../../common/types.schema.json#/$defs/instant"
        },
        "term_start": {
          "$ref": "../../common/types.schema.json#/$defs/instant"
        },
        "term_end": {
          "$ref": "../../common/types.schema.json#/$defs/instant"
        },
        "code": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "name": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "amount_kind": {
          "enum": [
            "total",
            "ceiling",
            "estimated"
          ],
          "description": "原文明确金额语义时填写；最高合同金额不得当作实际成交额"
        },
        "conditions": {
          "$ref": "defs.schema.json#/$defs/procurement_conditions"
        },
        "amount_kind_prov": {
          "$ref": "../../common/types.schema.json#/$defs/provenance"
        }
      },
      "dependentRequired": {
        "amount_kind": [
          "amount_kind_prov"
        ]
      }
    },
    "acceptance_section": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^acc_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "contract_id": {
          "type": "string",
          "pattern": "^ctr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "accepted_at": {
          "$ref": "../../common/types.schema.json#/$defs/instant"
        },
        "result": {
          "enum": [
            "passed",
            "partial",
            "failed"
          ]
        },
        "contract_code": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "contract_name": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "supplier": {
          "$ref": "../../common/types.schema.json#/$defs/org_ref"
        },
        "opinion": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "result_prov": {
          "$ref": "../../common/types.schema.json#/$defs/provenance"
        },
        "scope": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "dispute": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "验收争议的当事人主张；不等同法院认定，保留原文证据。"
        },
        "judicial_outcome": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../../common/types.schema.json#/$defs/text"
          },
          "description": "裁判结论原文段落分别溯源；技术质量、合同解除及付款结论分别保留，不把当事人主张作为法院结论。"
        }
      },
      "dependentRequired": {
        "result": [
          "result_prov"
        ]
      }
    },
    "ending_section": {
      "type": "object",
      "description": "终止、流标或废标",
      "required": [
        "ending_type"
      ],
      "additionalProperties": false,
      "properties": {
        "ending_type": {
          "enum": [
            "terminated",
            "failed_bid",
            "voided"
          ]
        },
        "lot_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "涉及的标包；为空表示全部"
        },
        "reason": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        }
      }
    }
  }
}
