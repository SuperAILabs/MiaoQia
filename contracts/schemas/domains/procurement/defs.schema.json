{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaoqia.com/domains/procurement/defs.schema.json",
  "x-version": "1.1.0",
  "title": "INF-PROC 公共定义",
  "description": "公告与采购项目共用的枚举和嵌套对象。对象含义见 docs/02-business/application-domains/tendering/04-domain-model.md。",
  "$defs": {
    "notice_type": {
      "enum": [
        "intent",
        "plan",
        "prequalification",
        "tender",
        "negotiation",
        "consultation",
        "inquiry",
        "single_source",
        "framework",
        "amendment",
        "clarification",
        "termination",
        "candidate",
        "award",
        "failure",
        "contract",
        "acceptance",
        "price_limit",
        "supplier_enrollment"
      ],
      "description": "意向、计划、资格预审、招标、谈判、磋商、询价、单一来源公示、框架协议征集、更正、澄清、终止、候选人公示、中标/成交结果、流标/废标、合同、验收、最高限价独立公告、供应商名录征集（不等同框架协议）"
    },
    "trading_system": {
      "enum": [
        "government_procurement",
        "construction_bidding",
        "soe_procurement"
      ],
      "description": "政府采购、依法必须招标的工程建设项目、国企自主采购"
    },
    "method": {
      "x-type-name": "ProcurementMethod",
      "enum": [
        "open_tender",
        "invited_tender",
        "negotiation",
        "consultation",
        "inquiry",
        "single_source",
        "framework",
        "comparison",
        "direct",
        "e_mall",
        "other",
        "selection"
      ],
      "description": "公开招标、邀请招标、竞争性谈判、竞争性磋商、询价、单一来源、框架协议、比选、直接采购、电商采购、其他、公开遴选"
    },
    "procurement_category": {
      "enum": [
        "goods",
        "works",
        "services"
      ]
    },
    "evaluation_method": {
      "enum": [
        "lowest_price",
        "comprehensive_scoring",
        "other"
      ]
    },
    "item": {
      "type": "object",
      "description": "采购标的",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "name": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "../../common/types.schema.json#/$defs/category"
          }
        },
        "spec": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "quantity": {
          "$ref": "../../common/types.schema.json#/$defs/quantity"
        },
        "brand_required": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "公告指定的品牌"
        },
        "model_required": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "unit_price": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "unit_price_unit": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "单价的计价单位原文，如“台”“m³”；缺失时单价不能与数量相乘或跨标的比较"
        }
      }
    },
    "requirement": {
      "type": "object",
      "description": "资格与技术要求",
      "required": [
        "id",
        "kind",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "enum": [
            "qualification",
            "performance",
            "personnel",
            "financial",
            "quality",
            "credit",
            "authorization",
            "consortium",
            "technical",
            "other"
          ]
        },
        "code": {
          "type": "string",
          "description": "归一的资质或要求代码；无法归一时省略，不使用 null。体系与版本见 code_scheme；缺 code_scheme 的代码按行业包默认资质体系解释，不能跨体系比较"
        },
        "text": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "code_scheme": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9-]+)*$",
          "description": "代码所属体系（平台登记，如 qual:mohurd-construction；平台登记体系与映射，不自称拥有外部标准）；只与 code 一起出现"
        },
        "code_scheme_version": {
          "type": "string",
          "minLength": 1,
          "description": "体系版本；只与 code_scheme 一起出现"
        },
        "grade_required": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "资质等级要求原文，如“二级及以上”"
        }
      }
    },
    "deadline": {
      "type": "object",
      "required": [
        "id",
        "type",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ddl_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "type": {
          "enum": [
            "registration_end",
            "doc_obtain_end",
            "clarification_end",
            "bid_submission",
            "bid_opening",
            "publicity_end",
            "registration_start",
            "doc_obtain_start",
            "bid_bond_end",
            "site_visit",
            "clarification_meeting"
          ]
        },
        "at": {
          "$ref": "../../common/types.schema.json#/$defs/instant"
        }
      }
    },
    "bid_result": {
      "type": "object",
      "description": "开标记录、候选人或中标结果中的一名投标人",
      "required": [
        "id",
        "stage",
        "bidder"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^bdr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "stage": {
          "enum": [
            "opening",
            "candidate",
            "award"
          ]
        },
        "bidder": {
          "$ref": "../../common/types.schema.json#/$defs/org_ref"
        },
        "consortium_members": {
          "type": "array",
          "items": {
            "$ref": "../../common/types.schema.json#/$defs/org_ref"
          },
          "minItems": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "is_winner": {
          "type": "boolean"
        },
        "price": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "score": {
          "type": "number"
        },
        "price_rate": {
          "$ref": "../../common/types.schema.json#/$defs/rate"
        },
        "result_kind": {
          "enum": [
            "contract_award",
            "framework_shortlist"
          ],
          "description": "普通中标或框架第一阶段入围；入围不代表第二阶段成交/签约"
        },
        "consortium_lead": {
          "$ref": "../../common/types.schema.json#/$defs/org_ref",
          "description": "仅在原文明确牵头人时填写，不把列表第一家推断为牵头人"
        },
        "price_kind": {
          "enum": [
            "total",
            "unit",
            "annual_unit_sum",
            "estimated_total"
          ],
          "description": "报价金额含义；年单价合计、单价和估算额不得当项目总成交额"
        },
        "price_kind_prov": {
          "$ref": "../../common/types.schema.json#/$defs/provenance"
        },
        "awarded_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/awarded_item"
          },
          "description": "该投标人中标或成交的标的明细（原文列出时）；缺失表示原文未列或未标注，不推断为与要求标的相同"
        }
      },
      "dependentRequired": {
        "price_kind": [
          "price",
          "price_kind_prov"
        ]
      }
    },
    "contact": {
      "type": "object",
      "description": "公开业务联系人，可明文检索与进入模型；姓名、电话、邮箱分别带证据定位，未知字段省略",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "buyer",
            "agency",
            "other",
            "project_owner",
            "technical_support",
            "supervisor"
          ]
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "organization": {
          "$ref": "../../common/types.schema.json#/$defs/org_ref"
        },
        "name_prov": {
          "$ref": "../../common/types.schema.json#/$defs/provenance"
        },
        "phone_prov": {
          "$ref": "../../common/types.schema.json#/$defs/provenance"
        },
        "email_prov": {
          "$ref": "../../common/types.schema.json#/$defs/provenance"
        }
      },
      "dependentRequired": {
        "name": [
          "name_prov"
        ],
        "phone": [
          "phone_prov"
        ],
        "email": [
          "email_prov"
        ]
      }
    },
    "procurement_conditions": {
      "type": "object",
      "description": "公告与项目标包共用的带证据采购条件；只记录已确认的原文，不把模板未选项当成事实",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "采购或建设范围"
        },
        "delivery_period": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "工期、交货期或服务期（保留相对时间原文）"
        },
        "delivery_location": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "交付地点原文"
        },
        "payment_terms": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "结算、付款条件"
        },
        "document_access": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "文件获取平台、地点、方式与时间窗口"
        },
        "submission_place": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "投标或响应递交地点/平台"
        },
        "opening_place": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "开标地点/平台"
        },
        "consortium_terms": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "联合体限制、成员职责和数量"
        },
        "sme_policy": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "中小企业预留、分包比例及适用条件"
        },
        "imported_products": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "进口产品限制"
        },
        "agent_participation": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "代理商参与条件"
        },
        "contract_pricing": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "固定总价、固定单价、费率等合同定价方式"
        },
        "planned_publication": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "计划招标发布时间原文，如2026-10；暂定计划不能当成已发布或投标截止时间"
        },
        "delivery_region": {
          "$ref": "../../common/types.schema.json#/$defs/region",
          "description": "交付地所在行政区划（能从原文确定时）；原文仍记在 delivery_location"
        }
      }
    },
    "awarded_item": {
      "type": "object",
      "description": "结果或合同公告中实际中标/成交的标的明细（中标方投标的产品），与公告要求侧的 item 分开：brand/model 是中标产品，不是 item 的 brand_required/model_required。可能无法与要求标的一一对应",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "能一一对应时引用要求侧标的；无法对应或原文未列要求标的时省略"
        },
        "name": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "标的或配置名称原文"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "../../common/types.schema.json#/$defs/category"
          }
        },
        "spec": {
          "$ref": "../../common/types.schema.json#/$defs/text"
        },
        "brand": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "中标产品品牌原文；品牌型号合并书写时按原文拆分，各自引用原文片段"
        },
        "model": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "中标产品型号原文"
        },
        "manufacturer": {
          "$ref": "../../common/types.schema.json#/$defs/org_ref",
          "description": "原文载明的制造商；不由品牌推断（品牌到所属组织的关系由 entity-graph 维护）"
        },
        "quantity": {
          "$ref": "../../common/types.schema.json#/$defs/quantity"
        },
        "unit_price": {
          "$ref": "../../common/types.schema.json#/$defs/money"
        },
        "unit_price_unit": {
          "$ref": "../../common/types.schema.json#/$defs/text",
          "description": "单价的计价单位原文，如“台”“m³”"
        }
      },
      "dependentRequired": {
        "unit_price": [
          "unit_price_unit"
        ]
      }
    }
  }
}
