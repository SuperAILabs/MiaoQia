{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaoqia.com/domains/organization/change.schema.json",
  "x-version": "0.2.0",
  "title": "OrgChange 企业变更记录",
  "description": "登记信息的一条变更记录。before / after 保留原文变更前后内容（含法定代表人、高管、自然人股东）；组织股东变化另以结构化方式记录。",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../common/types.schema.json#/$defs/public_fact_meta"
    },
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "status"
          }
        }
      },
      "then": {
        "required": [
          "status_after"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "capital"
          }
        }
      },
      "then": {
        "required": [
          "capital_after"
        ]
      }
    }
  ],
  "required": [
    "id",
    "info_domain",
    "subject",
    "change_type",
    "changed_on"
  ],
  "properties": {
    "info_domain": {
      "const": "INF-ORG"
    },
    "id": {
      "type": "string",
      "pattern": "^ogc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "subject": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref"
    },
    "change_type": {
      "$ref": "defs.schema.json#/$defs/change_type"
    },
    "change_item_raw": {
      "$ref": "../../common/types.schema.json#/$defs/text",
      "description": "原文变更事项"
    },
    "changed_on": {
      "$ref": "../../common/types.schema.json#/$defs/instant"
    },
    "before": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "after": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "status_after": {
      "$ref": "defs.schema.json#/$defs/status",
      "description": "仅 change_type = status"
    },
    "capital_before": {
      "$ref": "../../common/types.schema.json#/$defs/money"
    },
    "capital_after": {
      "$ref": "../../common/types.schema.json#/$defs/money"
    },
    "org_shareholders_added": {
      "type": "array",
      "items": {
        "$ref": "../../common/types.schema.json#/$defs/org_ref"
      }
    },
    "org_shareholders_removed": {
      "type": "array",
      "items": {
        "$ref": "../../common/types.schema.json#/$defs/org_ref"
      }
    }
  },
  "unevaluatedProperties": false
}
