{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.miaoqia.com/domains/organization/registration.schema.json",
  "x-version": "0.1.0",
  "title": "OrgRegistration 企业登记信息",
  "description": "一家企业在来源中公示的登记信息（照面信息、股东、分支机构），随来源变化产生新版本。",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../common/types.schema.json#/$defs/public_fact_meta"
    }
  ],
  "required": [
    "id",
    "info_domain",
    "subject",
    "name",
    "status"
  ],
  "properties": {
    "info_domain": {
      "const": "INF-ORG"
    },
    "id": {
      "type": "string",
      "pattern": "^ogr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "subject": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref",
      "description": "登记主体；org_id 为 entity-graph 解析后的组织"
    },
    "uscc": {
      "type": "string",
      "pattern": "^[0-9A-HJ-NPQRTUWXY]{2}[0-9]{6}[0-9A-HJ-NPQRTUWXY]{10}$",
      "description": "统一社会信用代码"
    },
    "name": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "former_names": {
      "type": "array",
      "items": {
        "$ref": "../../common/types.schema.json#/$defs/text"
      }
    },
    "enterprise_type": {
      "$ref": "defs.schema.json#/$defs/enterprise_type"
    },
    "enterprise_type_raw": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "status": {
      "$ref": "defs.schema.json#/$defs/status"
    },
    "established_on": {
      "$ref": "../../common/types.schema.json#/$defs/instant"
    },
    "business_term": {
      "$ref": "../../common/types.schema.json#/$defs/date_range"
    },
    "registered_capital": {
      "$ref": "../../common/types.schema.json#/$defs/money"
    },
    "paid_in_capital": {
      "$ref": "../../common/types.schema.json#/$defs/money"
    },
    "region": {
      "$ref": "../../common/types.schema.json#/$defs/region",
      "description": "登记机关所在行政区划"
    },
    "address": {
      "$ref": "../../common/types.schema.json#/$defs/text",
      "description": "住所（企业经营场所，非个人信息）"
    },
    "industry": {
      "$ref": "../../common/types.schema.json#/$defs/category",
      "description": "国民经济行业分类（GB/T 4754）"
    },
    "business_scope": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "registration_authority": {
      "$ref": "../../common/types.schema.json#/$defs/text"
    },
    "approved_on": {
      "$ref": "../../common/types.schema.json#/$defs/instant",
      "description": "核准日期"
    },
    "legal_representative": {
      "$ref": "../../common/types.schema.json#/$defs/person"
    },
    "shareholders": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/shareholder"
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "$ref": "../../common/types.schema.json#/$defs/org_ref"
      }
    },
    "parent": {
      "$ref": "../../common/types.schema.json#/$defs/org_ref",
      "description": "分支机构的隶属企业"
    }
  },
  "unevaluatedProperties": false
}
