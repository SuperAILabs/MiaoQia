            "type": "string",
            "pattern": "^RT-[A-Z]+-[A-Z]+$"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "description": "目标的发布批次与租户可启用的路线图阶段（批次见 05-release-plan.md 第2节）。目标目录完整列出，未到阶段的标注开放阶段、不可启用",
      "required": [
        "batch",
        "stage"
      ],
      "additionalProperties": false,
      "properties": {
        "batch": {
          "enum": [
            "R1",
            "R2",
            "R3"
          ]
        },
        "stage": {
          "enum": [
            "M2",
            "M3",
            "M4",
            "M5"
          ]
        }
      }
    },
    "signal_attr": {
      "description": "卡片可引用的信号属性（detection 的 Signal 与处理记录、channels 的组装结果），以 signal.<属性> 引用",
      "enum": [
        "objective",
        "fact_type",
        "disposition",
        "manual_disposition",
        "rank_score",
        "reasons",
        "unknown_count",
        "created_at",
        "evaluated_at",
        "exclusion_reason",
        "same_lot_winner_count",
        "processing_state",
        "my_feedback"
      ]
    },
    "display_source": {
      "type": "string",
      "description": "卡片字段的取值来源：signal.<属性>（signal_attr）；fact.<视图字段>（该事实类型在视图目录中的字段或视图项）；record.<路径>（该事实类型来源 Schema 中的展示字段，a.b[*].c）",
      "pattern": "^(signal\\.[a-z_]+|fact\\.[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*|record\\.[a-z_][a-z0-9_]*(\\[\\*\\])?(\\.[a-z_][a-z0-9_]*(\\[\\*\\])?)*)$"
    },
    "conditional_label": {
      "type": "object",
      "required": [
        "fact_type",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "fact_type": {
          "type": "string",
          "pattern": "^[a-z_]+\\.[a-z_]+$",
          "description": "事实类型（策略视图目录 views.yaml 的 fact_types 键）"
        },
        "when": {
          "$ref": "../policy/policy.schema.json#/$defs/expr",
          "description": "只读 fact 的 CEL 条件；缺省为该事实类型的默认标签。按列出顺序取第一条成立的"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "card_field": {
      "type": "object",
      "description": "卡片字段，按列出顺序为优先级从高到低；放不下时按优先级从低到高整项省略（never_omit 的除外），被省略的内容在详情中完整可见",
      "required": [
        "id",
        "label",
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditional_label"
          },
          "description": "按事实类型与条件变化的标签，例如结果公告的“中标金额”与合同公告的“合同金额”"
        },
        "source": {
          "$ref": "#/$defs/display_source"
        },
        "from": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/display_source"
          },
          "description": "按事实类型取值；未列出的事实类型不显示该字段。source 对卡片的全部事实类型都必须可解析"
        },
        "format": {
          "enum": [
            "text",
            "money",
            "party",
            "region",
            "categories",
            "datetime",
            "count",
            "score",
            "disposition",
            "reasons",
            "label",
            "exclusion_reason",
            "feedback"
          ]
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "description": "列表字段最多显示的条数（如命中理由最多两条）"
        },
        "missing_text": {
          "type": "string",
          "minLength": 1,
          "description": "取值缺失时显示的状态词（如“未公布”），不用其他字段代替"
        },
        "never_omit": {
          "type": "boolean",
          "description": "截断时永不省略（处置、金额类型、状态词等）"
        }
      },
      "oneOf": [
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "from"
            ]
          }
        },
        {
          "required": [
            "from"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        }
      ]
    },
    "card_action": {
      "type": "object",
      "required": [
        "action",
        "permission"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "view",
            "feedback_relevant",
            "feedback_irrelevant",
            "exclusion_feedback",
            "create_pursuit"
          ]
        },
        "permission": {
          "enum": [
            "can_view_signals",
            "can_feedback",
            "can_assign"
          ],
          "description": "渲染时按收件人当时的权限决定是否出现，执行时实时检查（identity 7.2）"
        },
        "reasons": {
          "enum": [
            "quick",
            "all"
          ],
          "description": "feedback_irrelevant 的原因选择：quick 为反馈定义的前 quick 个与“其他”，all 为全部"
        }
      }
    },
    "card": {
      "type": "object",
      "description": "信号卡片模板（渠道无关表示，channels 4.1、4.4；PRD 第3段 F2、第5段 F3–F4）。同一模板可用于收件箱行、简报条目、渠道卡片与即时通知卡片",
      "required": [
        "id",
        "version",
        "objective",
        "surfaces",
        "fact_types",
        "fact_type_labels",
        "fields",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CARD-[A-Z]+-[A-Z][0-9]{2}-[A-Z]+$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "objective": {
          "type": "string",
          "pattern": "^APP-[A-Z]+\\.[A-Z][0-9]{2}$"
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inbox_row",
              "briefing_item",
              "channel_card",
              "notification_card"
            ]
          }
        },
        "fact_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$",
            "description": "事实类型（策略视图目录 views.yaml 的 fact_types 键）"
          },
          "description": "等于该目标策略模板的事实类型并集"
        },
        "fact_type_labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditional_label"
          },
          "description": "事实类型的展示名（如 中标结果 / 候选人公示 / 合同公告 / 施工许可）"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/card_field"
          }
        },
        "markers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "new",
              "updated",
              "backfill",
              "overnight",
              "notified",
              "also_matched",
              "my_feedback",
              "same_lot_winners",
              "manual_disposition"
            ]
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/card_action"
          }
        }
      }
    },
    "briefing": {
      "type": "object",
      "description": "简报的目标分区声明（channels 4.4 第3条）：区的顺序、每区条数默认值与成员可调范围、即时通知的合并窗口。“待我处理”“关注变化”是平台跨目标区，不在此声明",
      "required": [
        "id",
        "version",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BRF-[A-Z]+-[A-Z]+$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "objective",
              "order",
              "title",
              "card",
              "quota"
            ],
            "additionalProperties": false,
            "properties": {
              "objective": {
                "type": "string",
                "pattern": "^APP-[A-Z]+\\.[A-Z][0-9]{2}$"
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "description": "区顺序；同一采购项目出现在多个区时只在靠前的区完整展示"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "card": {
                "type": "string",
                "pattern": "^CARD-[A-Z]+-[A-Z][0-9]{2}-[A-Z]+$"
              },
              "quota": {
                "type": "object",
                "required": [
                  "default",
                  "min",
                  "max"
                ],
                "additionalProperties": false,
                "properties": {
                  "default": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "min": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "description": "每区条数：默认值与成员偏好可调范围；24 小时内截止与更正类变化不受配额截断"
              },
              "merge_window": {
                "type": "string",
                "pattern": "^[0-9]+[mh]$",
                "description": "即时通知的合并窗口（channels 4.5），成员偏好可在此基础上调整"
              }
            }
          }
        }
      }
    },
    "feedback_tag": {
      "type": "object",
