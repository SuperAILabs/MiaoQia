        },
        "unit": {
          "enum": [
            "ratio",
            "count",
            "duration",
            "money",
            "distribution"
          ]
        },
        "numerator": {
          "type": "string",
          "minLength": 1
        },
        "numerator_filter": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/metric_dimension"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "分子固定的维度取值，如 {result_type: [success]}。比例指标的分组维度若在分子中被限定为比分母更窄的取值（分母未限定视为不限），各组恒为 0 或 100%，mqc P10 拒绝；分子、分母共用同一筛选（同一队列）时可以按该维度分组"
        },
        "denominator": {
          "type": "string",
          "minLength": 1
        },
        "denominator_filter": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/metric_dimension"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "分母固定的维度取值，如 {result_type: [success, failure]}；未列出的维度不限"
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "signal",
              "feedback",
              "outcome",
              "pursuit",
              "briefing",
              "delivery",
              "label_set"
            ]
          }
        },
        "window": {
          "type": "string",
          "pattern": "^[0-9]+[dw]$"
        },
        "segment_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/metric_dimension"
          }
        },
        "min_sample": {
          "type": "integer",
          "minimum": 1,
          "description": "样本少于此数时只报告数量，不报告比例"
        },
        "platform_metric": {
          "type": "string",
          "pattern": "^docs/.+\\.md#.+$",
          "description": "平台口径的指标（质量与验收）；本包只绑定目标与分层，不改口径"
        },
        "baseline": {
          "$ref": "#/$defs/cell",
          "description": "基线引用：已有基线集时 defined 列出版本，待定时注明阶段与任务"
        },
        "stage": {
          "enum": [
            "M2",
            "M3",
            "M4",
            "M5"
          ],
          "description": "开始计算的路线图阶段"
        },
        "pending": {
          "type": "object",
          "required": [
            "stage",
            "basis",
            "time_point"
          ],
          "additionalProperties": false,
          "description": "口径已定、但计算依赖尚未交付的能力：stage 为开始计算的阶段（与本指标 stage 相同），basis 为计数依据，time_point 为计入窗口的时点",
          "properties": {
            "stage": {
              "enum": [
                "M2",
                "M3",
                "M4",
                "M5"
              ]
            },
            "task": {
              "type": "string",
              "pattern": "^M[0-9]-P[0-9]+$"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "time_point": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "口径说明与算例"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "const": "ratio"
              }
            }
          },
          "then": {
            "required": [
              "denominator"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "money"
              }
            }
          },
          "then": {
            "required": [
              "segment_by"
            ]
          },
          "$comment": "金额必须按 value_nature、amount_type、currency 分组，由 mqc P10 检查"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "description": "效果指标与基线引用（learning 扩展点）。金额类指标按取值性质、金额类型与币种分列，不相加（learning 8.1，PRD 第6段 F7.1）",
      "required": [
        "id",
        "version",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MET-[A-Z]+$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    "metric_dimension": {
      "enum": [
        "objective",
        "disposition",
        "fact_type",
        "region",
        "category",
        "backfill",
        "reason_tag",
        "value_nature",
        "amount_type",
        "currency",
        "contribution",
        "result_type",
        "known_via",
        "bid_evidence",
        "submission_time"
      ],
      "description": "指标的分组与筛选维度。金额按取值性质、金额类型与币种分列，不相加（PRD 第6段 F7.1、第8节）。bid_evidence：已提交的依据，可同时具备多项，筛选按任一匹配（confirmed 为负责人确认，result 为结果可证：success 或 implies_bid 为 true 的 failure）；submission_time：提交时间 recorded 或 unknown"
    }
  }
}
