        },
        "relates": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "原因可能对应的规则、参数、档案字段、清单、视图项、词表或数据质量，供反馈汇总提示（PRD 第3段 F7 第2条），只作提示",
          "properties": {
            "rules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[RXWBP]-[A-Z0-9-]+$"
              }
            },
            "params": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "profile": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "lists": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "views": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z_]+\\.[a-z_]+$"
              }
            },
            "vocab": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "data_quality": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "feedback": {
      "type": "object",
      "description": "目标的信号反馈原因标签（learning 扩展点；PRD 第3段 F4、第13节第2项）。代码进入反馈记录与事件，展示文字可改，代码不改义",
      "required": [
        "id",
        "version",
        "objective",
        "irrelevant",
        "quick",
        "exclusion_wrong"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FB-[A-Z]+-[A-Z][0-9]{2}$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "objective": {
          "type": "string",
          "pattern": "^APP-[A-Z]+\\.[A-Z][0-9]{2}$"
        },
        "irrelevant": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/feedback_tag"
          },
          "description": "不相关：至少选一个；最后一项为须说明的“其他”"
        },
        "quick": {
          "type": "integer",
          "minimum": 1,
          "description": "渠道卡片上展示的不相关原因个数（列表前 quick 个，另加“其他”）"
        },
        "relevant": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feedback_tag"
          },
          "description": "相关：可选标签"
        },
        "exclusion_wrong": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/feedback_tag"
          },
          "description": "排除有误：须选原因；最后一项为“其他”"
        }
      }
    },
    "outcome": {
      "type": "object",
      "description": "交易型目标的推进结果类型、原因代码与金额类型（PRD 第6段 F7、第13节第8–9项）。结果原因与信号反馈原因分开：一个是“做的结果”，一个是“值不值得做”",
      "required": [
        "id",
        "version",
        "objective",
        "results",
        "amount_types"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OUT-[A-Z]+-[A-Z][0-9]{2}$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "objective": {
          "type": "string",
          "pattern": "^APP-[A-Z]+\\.[A-Z][0-9]{2}$"
        },
        "submission_evidence": {
          "type": "boolean",
          "description": "结果是否用于判断已提交（如投标）。为 true 时每个 failure 原因必须以 implies_bid 声明该原因能否证明已提交；success 视为已提交，abandoned 视为未提交（mqc P10）"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "say",
              "known_at_required",
              "reasons"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "success",
                  "failure",
                  "abandoned"
                ]
              },
              "say": {
                "type": "string",
                "minLength": 1
              },
              "known_at_required": {
                "type": "boolean",
                "description": "关闭时是否必须填写获知时间（可只到日）"
              },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "say",
                    "relates_to"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]*$"
                    },
                    "say": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note_required": {
                      "type": "boolean"
                    },
                    "relates_to": {
                      "enum": [
                        "product",
                        "price",
                        "qualification",
                        "relationship",
                        "timing",
                        "project",
                        "risk",
                        "resource",
                        "data",
                        "other"
                      ],
                      "description": "原因对应的问题类别，供评估与改进建议归类"
                    },
                    "implies_bid": {
                      "type": "boolean",
                      "description": "仅 failure 原因：该原因只能在提交之后发生（如报价不具竞争力）为 true；流标、终止、资格预审未通过等不能证明已提交的为 false"
                    }
                  }
                }
              }
            }
          }
        },
        "amount_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "say"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "say": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "结果金额条目的金额类型；不同类型、不同取值性质的金额不相加"
        }
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "id",
        "name",
        "objectives",
        "layer",
        "unit",
        "numerator",
        "source",
        "window",
        "stage"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^APP-[A-Z]+\\.[A-Z][0-9]{2}$"
          }
        },
        "layer": {
          "enum": [
            "monitoring",
            "value",
            "engagement"
          ],
