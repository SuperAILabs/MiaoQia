# Copy to config/local/vps.env (untracked). The VPS helper scripts in
# tools/dev read the shared test VPS address and SSH access from it.
MIAOQIA_VPS_HOST=replace-with-the-shared-test-vps-address
MIAOQIA_VPS_SSH_USER=replace-with-the-ssh-user
MIAOQIA_VPS_SSH_KEY=/absolute/path/to/the/ssh/private/key
