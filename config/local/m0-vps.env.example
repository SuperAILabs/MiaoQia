# Copy to config/local/m0-vps.env and fill the secret placeholders once.
# tools/dev/run-m0-vps.sh selects this file explicitly; shell variables win.
# The wrapper provides this temporary local Kafka tunnel automatically.
MIAOQIA_KAFKA_BROKERS=127.0.0.1:29094
MIAOQIA_IDENTITY_OPENFGA_URL=https://fga.lai.co
MIAOQIA_IDENTITY_OPENFGA_TOKEN=replace-with-the-vps-fga-token
MIAOQIA_GATEWAY_ISSUER=https://auth.lai.co/realms/miaoqia
MIAOQIA_GATEWAY_AUDIENCE=miaoqia-api
MIAOQIA_E2E_CLIENT_ID=miaoqia-dev
MIAOQIA_E2E_OPERATOR_PASSWORD=replace-with-the-vps-operator-password
MIAOQIA_E2E_VISITOR_PASSWORD=replace-with-the-vps-visitor-password
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.lai.co
# The shared Collector stores traces on the VPS. Set false for the local
# functional run; full trace-file verification requires a local Collector or
# a trace-file sync step.
MIAOQIA_E2E_TRACE_REQUIRED=false
