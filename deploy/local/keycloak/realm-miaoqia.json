{
  "realm": "miaoqia",
  "enabled": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "miaoqia-dev",
      "name": "本地开发与端到端测试（仅本地环境）",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "miaoqia-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "miaoqia-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "miaoqia-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "miaoqia_tenant",
            "claim.name": "miaoqia_tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "multivalued": "false"
          }
        },
        {
          "name": "miaoqia-cell",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "miaoqia_cell",
            "claim.name": "miaoqia_cell",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "miaoqia-integration-admin",
      "name": "仅隔离本地/CI设置测试用户属性；禁止作为生产客户端",
      "publicClient": false,
      "secret": "isolated-integration-only",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "本地",
      "lastName": "运营",
      "email": "operator@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ]
    },
    {
      "username": "visitor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "本地",
      "lastName": "访客",
      "email": "visitor@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "visitor",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-miaoqia-integration-admin",
      "enabled": true,
      "serviceAccountClientId": "miaoqia-integration-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "manage-realm"
        ]
      }
    }
  ]
}
