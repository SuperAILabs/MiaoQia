{
  "realm": "miaoqia",
  "enabled": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "miaoqia-dev",
      "name": "本地开发与端到端测试（仅本地环境）",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "miaoqia-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "miaoqia-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "本地",
      "lastName": "运营",
      "email": "operator@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ]
    },
    {
      "username": "visitor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "本地",
      "lastName": "访客",
      "email": "visitor@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "visitor",
          "temporary": false
        }
      ]
    }
  ]
}
