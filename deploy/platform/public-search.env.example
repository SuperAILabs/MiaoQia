# Public search. Apply only the keys needed by the selected platform role.
# The production platform owner supplies hosts, TLS credentials, database
# secrets and deployment policy. Development fixtures use synthetic data.
MIAOQIA_DEPLOY_DIR=deploy

# API, workflow worker and one-shot search-build use separate OpenSearch
# reader, writer and publisher client certificates. Mount publisher
# credentials only into the one-shot build and publication task.
MIAOQIA_PUBLIC_SEARCH_NAMESPACE=procurement
MIAOQIA_PUBLIC_SEARCH_OPENSEARCH_URL=https://public-opensearch.example.invalid:9200
MIAOQIA_PUBLIC_SEARCH_OPENSEARCH_TLS_CA=/run/secrets/public-search/opensearch-ca.pem
MIAOQIA_PUBLIC_SEARCH_OPENSEARCH_TLS_CERT=/run/secrets/public-search/opensearch-client.pem
MIAOQIA_PUBLIC_SEARCH_OPENSEARCH_TLS_KEY=/run/secrets/public-search/opensearch-client.key

# public-search-api
MIAOQIA_GATEWAY_ISSUER=https://idp.example.invalid/realms/miaoqia
MIAOQIA_GATEWAY_AUDIENCE=miaoqia-api
MIAOQIA_HTTP_ADDR=:8090
MIAOQIA_PUBLIC_TLS_CERT=/run/secrets/public-search/listener.pem
MIAOQIA_PUBLIC_TLS_KEY=/run/secrets/public-search/listener.key
MIAOQIA_PUBLIC_SEARCH_IDENTITY_URL=https://platform-api:8091/internal
MIAOQIA_PUBLIC_SEARCH_DATA_API_URL=https://data-api:8443
# Keep this discovery allowlist aligned with the owner export configuration.
MIAOQIA_PUBLIC_SEARCH_DISCOVERY_SOURCES='[]'
# Generate with openssl rand -base64 32 and distribute to API replicas.
MIAOQIA_PUBLIC_SEARCH_CURSOR_KEY=

# API and workflow worker. Use a distinct role certificate per process.
# API SPIFFE: spiffe://miaoqia/service/platform-public-search-api.
# Worker SPIFFE: spiffe://miaoqia/service/platform-public-search-workflow-worker.
MIAOQIA_INTERNAL_TLS_CA=/run/secrets/public-search/internal-ca.pem
MIAOQIA_INTERNAL_TLS_CERT=/run/secrets/public-search/service.pem
MIAOQIA_INTERNAL_TLS_KEY=/run/secrets/public-search/service.key

# public-search-consumer and public-search-workflow-worker
# Provision with public-search.postgres.sql; inject secret DSNs using the
# sea_public database and sea_public_owner / sea_public_app login roles.
# Run platform -role public-search-consumer migrate using only the owner DSN.
MIAOQIA_PUBLIC_SEARCH_DB_OWNER_DSN=
MIAOQIA_PUBLIC_SEARCH_DB_DSN=

# public-search-consumer and search-build publish. Publish samples partition ends.
MIAOQIA_KAFKA_BROKERS=
# For a verified TLS listener, set MIAOQIA_KAFKA_TLS_CA to the broker CA file.
# SCRAM also needs MIAOQIA_KAFKA_SASL_USERNAME, MIAOQIA_KAFKA_SASL_PASSWORD
# and MIAOQIA_KAFKA_SASL_MECHANISM (SCRAM-SHA-256 or SCRAM-SHA-512).

# public-search-workflow-worker
# Set distinct fixed generations for the two development VPS worker services.
MIAOQIA_PUBLIC_SEARCH_OWNER_EXPORT_URL=https://public-search-export.example.invalid
# The trusted build driver supplies an existing generation with a sealed snapshot.
MIAOQIA_PUBLIC_SEARCH_GENERATION=
