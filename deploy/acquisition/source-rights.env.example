# Disabled by default. This file is a reviewed shape, not deployable credentials or a source activation.
MIAOQIA_ACQUISITION_RIGHTS_ENABLED=0
MIAOQIA_ACQUISITION_RIGHTS_LISTEN=127.0.0.1:8092
# Install separate read/operator/owner DSNs through deployment secret management; never give them to data.
MIAOQIA_ACQUISITION_RIGHTS_READER_DSN=
MIAOQIA_ACQUISITION_RIGHTS_OPERATOR_DSN=
MIAOQIA_ACQUISITION_DB_OWNER_DSN=
MIAOQIA_INTERNAL_TLS_CERT=
MIAOQIA_INTERNAL_TLS_KEY=
MIAOQIA_INTERNAL_TLS_CA=
MIAOQIA_IDENTITY_URL=https://platform-api:8091/internal
MIAOQIA_IDENTITY_PEER=spiffe://miaoqia/service/platform-api
# Proposed peer URI mirrors the existing data-api role; must be present in the actual issued certificate.
# The existing platform-api URI is reused for identity. No wildcard peer or deployment default allow.
# Service purposes name the exact service principal data-api may relay; interactive entries name none.
MIAOQIA_ACQUISITION_RIGHTS_DELEGATIONS='[{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.resolve","purpose":"interactive"},{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.confirm","purpose":"interactive"},{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.status","purpose":"interactive"},{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.resolve","purpose":"monitoring","principal":"svc:detection"},{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.confirm","purpose":"monitoring","principal":"svc:detection"},{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.status","purpose":"monitoring","principal":"svc:detection"},{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.resolve","purpose":"simulation","principal":"svc:learning"},{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.confirm","purpose":"simulation","principal":"svc:learning"},{"peer":"spiffe://miaoqia/service/data-api","operation":"rights.status","purpose":"simulation","principal":"svc:learning"}]'
